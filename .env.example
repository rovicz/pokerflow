# ==========================================================================
# PokerFlow — Variáveis de Ambiente (copie para .env.local e preencha)
# ==========================================================================

# Supabase (Servidor — NUNCA expor SERVICE_ROLE_KEY no client)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Supabase (Público — seguro com RLS habilitado)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública da aplicação (usada nos links de confirmação de e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Servidor — envio de e-mails de confirmação e recuperação de senha)
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL="PokerFlow <onboarding@resend.dev>"
